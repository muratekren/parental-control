<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Setup &amp; hardening (run once)"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Server URL"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/et_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://guard.example.com/api"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API secret"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/et_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="same as API_SECRET on the worker"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Device name"
            android:textColor="@color/muted" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Honor Tablet"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Enable Device Admin" />

            <Button
                android:id="@+id/btn_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Grant Usage Access" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Exempt from Battery Optimization" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Start Protection" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/good"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>